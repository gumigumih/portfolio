---
import App from '../../App'
import '../../index.css'

export function getStaticPaths() {
  const projectIds = [
    'virtualBusinessCard',
    'culturalHeritage3D',
    'streamingManager',
    'miuraKamakura',
    'majikaruLove',
    'fukuokaVsapo',
    'niceCamera',
    'aiKataS2p',
    'nijisanjiKuji',
    'youtubeScheduler',
    'snackAR',
  ]

  return projectIds.map((projectId) => ({
    params: { projectId },
  }))
}
